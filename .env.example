# Server configuration
HOST=0.0.0.0
PORT=3000

# Movies storage
MOVIES_DIR=/home/kristofervool/movies

# VLC display settings (for Raspberry Pi)
DISPLAY=:0
XAUTHORITY=/home/kristofervool/.Xauthority

# OpenSubtitles API configuration
# Get your API key from https://www.opensubtitles.com/en/consumers
OPENSUBTITLES_API_KEY=your_api_key_here
OPENSUBTITLES_USER_AGENT=TurboPi v1.0
OPENSUBTITLES_USERNAME=your_username
OPENSUBTITLES_PASSWORD=your_password

# Environment
NODE_ENV=development
